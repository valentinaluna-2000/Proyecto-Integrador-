# ============================================================
# Rentify - Variables de entorno
# Copia este archivo como ".env" en la raiz del proyecto y
# completa los valores segun tu entorno. docker-compose.yml
# lee automaticamente el archivo ".env" de la raiz.
# ============================================================

# ---- Base de datos (PostgreSQL) ----
POSTGRES_DB=rentify
POSTGRES_USER=rentify
POSTGRES_PASSWORD=rentify

# ---- Backend / JWT ----
NODE_ENV=development
JWT_SECRET=cambia-este-secreto-por-uno-propio-y-largo
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000
RESERVATION_HOLD_MINUTES=90
MAX_IMAGE_SIZE_MB=5

# ---- Bootstrap del primer administrador (propietario/titular) ----
# Se utilizan una unica vez, la primera vez que corres el seed.
ADMIN_EMAIL=admin@rentify.local
ADMIN_PASSWORD=Admin1234
ADMIN_USERNAME=admin

# ---- Correo saliente (recuperacion de contrasena, confirmaciones) ----
# En desarrollo se usa MailHog (ya incluido en docker-compose, no requiere
# credenciales). Para produccion, apunta esto a tu propio servidor SMTP.
MAIL_FROM=no-responder@rentify.local

# ---- Mercado Pago ----
# Genera credenciales de prueba (sandbox) en
# https://www.mercadopago.com.ar/developers/panel/app
# Sin este valor, el flujo de pago no puede generar la preferencia de
# Mercado Pago (el resto del sistema sigue funcionando con normalidad).
MERCADOPAGO_ACCESS_TOKEN=

# ---- Google Maps ----
# API Key con "Maps Embed API" habilitada:
# https://console.cloud.google.com/google/maps-apis
# Sin este valor, el detalle de la propiedad muestra un enlace a Google Maps
# en lugar del mapa embebido (degradacion controlada, no rompe el flujo).
GOOGLE_MAPS_API_KEY=

# ---- Servicio meteorologico ----
# El sistema usa Open-Meteo (https://open-meteo.com) por defecto, que no
# requiere API key. Esta variable queda reservada para reemplazar el
# proveedor en el futuro sin tocar el resto de la arquitectura.
WEATHER_API_KEY=
