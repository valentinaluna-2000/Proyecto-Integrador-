# Variables de entorno para correr el backend LOCALMENTE (fuera de Docker),
# por ejemplo desde VS Code con "npm run start:dev". Copia este archivo como
# ".env" dentro de la carpeta backend/. Si Postgres corre via docker-compose,
# usa POSTGRES_HOST=localhost (el puerto 5432 esta expuesto al host).

NODE_ENV=development
BACKEND_PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rentify
POSTGRES_USER=rentify
POSTGRES_PASSWORD=rentify

JWT_SECRET=cambia-este-secreto-por-uno-propio-y-largo
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:3000

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-responder@rentify.local

RESERVATION_HOLD_MINUTES=90
MAX_IMAGE_SIZE_MB=5

ADMIN_EMAIL=admin@rentify.local
ADMIN_PASSWORD=Admin1234
ADMIN_USERNAME=admin

MERCADOPAGO_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=
