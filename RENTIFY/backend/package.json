{
  "name": "rentify-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "migration:run": "typeorm migration:run -d dist/persistence/data-source.js",
    "seed": "node dist/persistence/seed.js",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --config jest.integration.cjs",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "dlq:replay": "node dist/notifications/replay-dlq.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/microservices": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@supabase/supabase-js": "^2.57.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "kafkajs": "^2.2.4",
    "luxon": "^3.7.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.35.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
